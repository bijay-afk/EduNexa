# NestJS API environment (copy to .env and fill in)
NODE_ENV=development
PORT=3000

# PostgreSQL with pgvector extension (see docker-compose.yml at repo root)
#
# Supabase connection strategy:
#   - RUNTIME (api server, seeds/scripts, tests): use the transaction pooler,
#     e.g. postgresql://user:pass@aws-0-region.pooler.supabase.com:6543/postgres
#   - SCHEMA/MIGRATION ops (prisma db push / migrate, prisma CLI): use the
#     DIRECT connection on 5432 (the schema engine does not work through
#     PgBouncer transaction pooling and will hang on 6543). Derive it from the
#     pooler URL by replacing ":6543/postgres" with ":5432/postgres" and adding
#     connect_timeout, e.g.:
#       $env:DATABASE_URL=($url -replace ':\d+/(postgres)',':5432/$1') + '?connect_timeout=30'
DATABASE_URL="postgresql://edunexa:edunexa@localhost:5432/edunexa?schema=public"

# Redis for BullMQ queues + cache
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Object storage (media / exports) — later phases
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT=

# AI — choose a provider. Subject starts fully free via Ollama (local, no key):
#   ollama pull qwen2.5:7b && ollama pull nomic-embed-text  (requires `ollama serve`)
#   AI_PROVIDER=ollama
#   AI_MODEL=qwen2.5:7b
#   AI_CHAT_BASE_URL=http://localhost:11434/v1
#   AI_EMBEDDING_MODEL=nomic-embed-text
#   AI_EMBEDDING_BASE_URL=http://localhost:11434
#
# Production queue controls (spec §16–§20):
#   AI_CONCURRENCY=1            # BullMQ worker concurrency — keep 1 on Ollama
#   AI_JOB_TIMEOUT_MS=900000    # per-job timeout before retry/backoff (15 min)
#   AI_MAX_QUESTIONS_PER_GENERATION=20
#   AI_EMBED_BATCH_SIZE=32      # embedding batch size for the db:embed: papers script
#
# OpenAI (paid) — key is never committed:
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_CHAT_BASE_URL=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_BASE_URL=

# Observability
SENTRY_DSN=