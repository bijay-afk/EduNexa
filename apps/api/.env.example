# NestJS API environment (copy to .env and fill in)
NODE_ENV=development
PORT=3000

# PostgreSQL with pgvector extension (see docker-compose.yml at repo root)
DATABASE_URL="postgresql://class10:class10@localhost:5432/class10?schema=public"

# Redis for BullMQ queues + cache
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Object storage (media / exports) — later phases
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT=

# AI (Phase 5) — provider key is never committed
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Observability
SENTRY_DSN=